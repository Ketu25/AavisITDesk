# Public configuration, committed on purpose.
#
# next build INLINES every NEXT_PUBLIC_* value into the bundle, so these have to
# exist at BUILD time — a Cloudflare Worker runtime variable is set too late and
# is ignored. Keeping them here makes the build self-sufficient instead of
# depending on dashboard settings being correct.
#
# All three are public by design: the URL and publishable key are visible in the
# browser bundle of every Supabase app, and Row Level Security is the actual
# security boundary. Real environment variables still take precedence over this
# file, so the dashboard can override any of it.
#
# The service role key is NOT here and must never be. It is a Worker secret:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY

NEXT_PUBLIC_SUPABASE_URL=https://alslqimadvhrriwdkgrm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Q_ZKFoBamPOcrrxbhHhRkA_DkaEpg0H
NEXT_PUBLIC_SITE_URL=https://aavisitdesk.ketupatel2599.workers.dev
